{
  "expo": {
    "name": "On Time Taxi",
    "slug": "ott-rider",
    "scheme": "ott",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#FFC629"
    },
    "ios": {
      "bundleIdentifier": "com.ontimetaxi.rider",
      "supportsTablet": false
    },
    "android": {
      "package": "com.ontimetaxi.rider"
    },
    "plugins": [
      "expo-router"
    ]
  }
}