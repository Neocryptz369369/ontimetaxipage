{
  "expo": {
    "name": "On-Time Driver",
    "slug": "on-time-taxi-driver",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ontimedriver",
    "ios": {
      "bundleIdentifier": "app.ontimetaxi.driver",
      "config": { "googleMapsApiKey": "REPLACE_ME" },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to dispatch rides.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Background location keeps you dispatchable while driving.",
        "UIBackgroundModes": ["location", "fetch"]
      }
    },
    "android": {
      "package": "app.ontimetaxi.driver",
      "config": { "googleMaps": { "apiKey": "REPLACE_ME" } },
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_BACKGROUND_LOCATION", "FOREGROUND_SERVICE"]
    },
    "plugins": [
      ["expo-location", { "locationAlwaysAndWhenInUsePermission": "Allow On-Time Driver to use your location." }]
    ],
    "extra": {
      "SUPABASE_URL": "https://YOUR-PROJECT.supabase.co",
      "SUPABASE_ANON_KEY": "YOUR_ANON_KEY"
    }
  }
}
